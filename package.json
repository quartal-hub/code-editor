{
  "name": "quartal-hub-code-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -C packages/web dev",
    "build": "pnpm -r build",
    "preview": "pnpm -C packages/web preview",
    "build:web": "pnpm -C packages/web build",
    "build:react-editors": "pnpm -C packages/react-editors build",
    "lint": "pnpm -r lint"
  }
}
