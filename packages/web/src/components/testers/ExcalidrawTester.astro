---
import { getExcalidrawExamples } from "@/examples/getExcalidrawExamples";

const { description } = Astro.props;

let examples = getExcalidrawExamples();

const firstExampleProps = examples[0].props;

---
<div class="container-fluid h-100">
  <div class="lead">
    {description}
  </div>
  <div class="row mt-3 h-100">
    <div class="col-3" style="height: 100%; overflow-y: auto;">
      <div class="list-group">
        {examples.map((example, index) => (
          <button
            class="list-group-item list-group-item-action"
            type="button"
            data-index={index}
          >
            <div>{example.title}</div>
            <div class="text-muted"><small>{example.descr}</small></div>
          </button>
        ))}
      </div>
    </div>
    <div class="col-9">
      <qrtl-code-editor style="display: block; width: 100%; height: 100%;" {...firstExampleProps}></qrtl-code-editor>
    </div>
  </div>
</div>

<script type="module" src="/qrtl-code-editor.js"></script>
<script type="module" define:vars={{ examples }}>
  const editor = document.querySelector("qrtl-code-editor");
  const buttons = document.querySelectorAll("[data-index]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const index = Number(button.getAttribute("data-index"));
      const example = examples[index];
      if (example) {
        editor.applyProps(example.props);
      }
    });
  });
</script>
