---
import TesterLayout from "@/layouts/TesterLayout.astro";
import { getTodoExamples } from "@/examples/getTodoExamples";

const examples = getTodoExamples("project");
const firstExampleProps = examples[0].props;

---

<TesterLayout title="Project Editor Tester">
  <div class="container-fluid px-5" style="height: calc(100vh - 120px);">
    <q-editor style="display: block; width: 100%; height: 100%;" {...firstExampleProps}></q-editor>
  </div>
</TesterLayout>

<script type="module" define:vars={{ examples }}>
  import { defineQEditorElement } from "/src/publish/QEditorElement";
  defineQEditorElement();
</script>