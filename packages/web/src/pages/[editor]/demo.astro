---
import type { EditorType } from "@quartal/code-editors-core";

import TesterLayout from "@/layouts/TesterLayout.astro";
import ExampleWrapper from "@/components/layout/ExampleWrapper.vue";
import FilesEditorDemo from "@/components/layout/FilesEditorDemo.vue";
import { editorInfo, editorList } from "@/data";

export function getStaticPaths() {
  return editorList.map((editor) => ({ params: { editor } }));
}

const { editor } = Astro.params;
const editorConfig = editorInfo[editor as EditorType];
const title = editorConfig?.title ? `${editorConfig.title} demo` : "Editor demo";

const editorType = editor as EditorType;
---

<TesterLayout title={title}>
  {editorType === "files" && <FilesEditorDemo client:only="vue" />}
  {editorType && editorType !== "files" && (
    <ExampleWrapper editor={editorType} client:only="vue" />
  )}
  {!editorType && (
    <div class="alert alert-danger mx-auto w-50 mt-5">Editor "{editor}" not found</div>
  )}
</TesterLayout>
