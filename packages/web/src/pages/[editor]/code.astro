---
import EditorLayout from "@/layouts/EditorLayout.astro";

import CodeWrapper from "@/components/pages/CodeWrapper.vue";
import CodeWrapperReact from "@/components/pages/CodeWrapperReact.tsx";

import { editorInfo, editorList } from "@/data";
import type { EditorType } from "@quartal/code-editors-core";

export function getStaticPaths() {
  return editorList.filter((editor) => editor !== "files").map((editor) => ({ params: { editor } }));
}

const { editor } = Astro.params;
const editorConfig = editorInfo[editor as EditorType];
const pageTitle = editorConfig?.title ?? "Editor";
const platform: "vue" | "react" = editorConfig?.platform;
---

<EditorLayout title={pageTitle}>
  {platform === "vue" && (
    <CodeWrapper
      editor={editor as "monaco" | "expression" | "class" | "function" | "markdown" | "markdown-hybrid"}
      client:only="vue" />
  )}
  {platform === "react" && (
    <CodeWrapperReact
      editor={editor as "monaco-react" | "excalidraw"}
      client:only="react" />
  )}
  {!platform && (
    <div class="alert alert-danger mx-auto w-50 mt-5">Unknown platform for editor "{editor}"</div>
  )}
</EditorLayout>
